# Database connection
# For Render: paste your Render PostgreSQL connection string (Internal or External)
# Example: postgresql://username:password@hostname/dbname
# If left blank, it will automatically use SQLite locally: sqlite:///./trading_tracker.db
DATABASE_URL=

# Telegram Bot Settings
# Create bot via @BotFather to get token
TELEGRAM_BOT_TOKEN=
# Get your chat ID from @userinfobot
TELEGRAM_CHAT_ID=

# Account & Rules Target
INITIAL_BALANCE=10.0
TARGET_BALANCE=100.0
MAX_DAILY_SETUPS=2
